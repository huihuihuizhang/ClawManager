  "review_findings_and_resolutions": [
    {
      "priority": "P1",
      "finding": "Terminal and native-host loaders selected issuer plan/public from a second locator read without matching its already authenticated source.files SHA; restoring original locator before final current-file checks could conceal transient selection of a non-enrolled signing key.",
      "resolution": "Both real call sites use readBootstrapOriginalPublicSource. It compares exact locator bytes against authenticated same-path original pin before selecting plan/key, preserves independent plan/public hashes and poisons the loaded attempt on failure. Existing final current checks remain.",
      "proof": "Two actual consumer-load + shared production key-selection regressions use exact pinned mapping/native record and real foreign Ed25519 signatures, reject transient foreign locator then restore original bytes, reject reuse of poisoned source and allow a new independent original load. These are not complete thirty-owner positive admission tests."
    },
    {
      "finding": "Evidence fixture used generic Transactions.Run without bootstrap clockContext, so initial source.Lock refused before positive read and some fault tests could pass before injection.",
      "resolution": "Only test fixture changed to actual caller-owned RepeatableRead tx with GuardInTx, original guarded SampleTime/floor and explicit commit; forwarded driver query counters require reaching evidence/chunk reads and successful-Lock callbacks as appropriate. Production transaction/source checks unchanged.",
      "proof": "Positive detached-facts and all original EOF/projection/chunk/current/copy/context tests passed under Linux."
    },
    {
      "finding": "Two issuer fixtures moved ResultRequest.Scope but left Evidence.OwnerID at vector installation; strict producer validation refused before signed issuer path.",
      "resolution": "Only fixture owner association changed before original hash calculation. Producer validation unchanged. Revocation negative now also requires both actual producer record reads and intended original admin role mutation.",
      "proof": "Previously failing four issuer/native-host/classification roots now pass."
    },
    {
      "priority": "P2",
      "finding": "DB/Teams signed source grant windows accepted by mapper could be refused later by worker for zero NotBefore or lifetime over 24 hours.",
      "resolution": "Mapper rejects before CREATE; same actual worker constraints, original key/signature/scope/file hashes and unchanged signed definition window coverage retained.",
      "proof": "Linux executes all four independently re-signed zero/25h DB/Teams cases without skips."
    },
    {
      "priority": "P2",
      "finding": "Database source grant output could collide with reserved future capture bundle/metadata or existing Redis/object grant coordinates.",
      "resolution": "Exact original typed definition/hash and clean absolute output precheck runs before authority recheck, private signing-key read or native issuer. No cleanup/rename substitutes for refusal.",
      "proof": "Linux executes four reserved-coordinate cases, confirms no extra SQL/sign/native path and no mutation of existing or future outputs."
    },
    {
      "finding": "MinIO finite error parser needed optional exact signed Region while rejecting malformed or foreign values.",
      "resolution": "C explicit region supersede retains exact status/code/key/EOF and all duplicate/unknown/structure refusals.",
      "proof": "All ten MinIO protocol/concrete-owner component roots pass; no live MinIO compatibility claim."
    }
  ],
  "implemented_source_boundaries": [
    "Original A terminal consumes independently signed full selection/owner bindings, original capture current SQL, complete C1 record projections and evidence metadata/chunks to EOF, original capacity/retention and same original context/transaction. Missing compiled owners still close before credentials/provider/SQL work.",
    "Native host supplement derives actual workload through existing production peer observer, binds immutable peer ConfigMap, exact imageID and PodSpec profiles rather than accepting copied workload hashes. These tests use controlled Kubernetes transport.",
