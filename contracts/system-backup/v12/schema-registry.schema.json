{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.local/contracts/system-backup/v12/schema-registry.schema.json",
  "title": "ClawManager system backup schema registry draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "registry_version",
    "contract_version",
    "contract_status",
    "plan_source",
    "migration_catalog",
    "schema_hash",
    "summary",
    "objects"
  ],
  "properties": {
    "kind": { "const": "system_backup_schema_registry" },
    "registry_version": { "const": "system-backup-schema-registry.v1" },
    "contract_version": { "const": "system-backup-plan.v12" },
    "contract_status": { "enum": ["draft", "frozen"] },
    "plan_source": { "type": "string", "minLength": 1 },
    "migration_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "file_count", "hash"],
      "properties": {
        "algorithm": { "const": "sha256-length-prefixed-filename-normalized-content-v1" },
        "file_count": { "type": "integer", "minimum": 1 },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schema_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "status", "hash", "evidence"],
      "properties": {
        "algorithm": { "const": "sha256-information-schema-canonical-v1" },
        "status": { "enum": ["pending_live_evidence", "observed"] },
        "hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["public_id", "sha256"],
              "properties": {
                "public_id": { "type": "string", "pattern": "^sev_[A-Za-z0-9_-]+$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "pending_live_evidence" } }, "required": ["status"] }, "then": { "properties": { "hash": { "type": "null" }, "evidence": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] }, "then": { "properties": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "evidence": { "type": "object" } } } }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_count", "policy_recorded", "policy_pending", "cross_review_pending"],
      "properties": {
        "object_count": { "type": "integer", "minimum": 1 },
        "policy_recorded": { "type": "integer", "minimum": 0 },
        "policy_pending": { "type": "integer", "minimum": 0 },
        "cross_review_pending": { "type": "integer", "minimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "name",
        "owner",
        "category",
        "data_classification",
        "backup_strategy",
        "restore_strategy",
        "excluded_reason",
        "normalizer_id",
        "verifier_id",
        "depends_on",
        "decision_status",
        "required_cross_reviewers",
        "approved_cross_reviewers",
        "redacted_explanation",
        "sources"
      ],
      "properties": {
        "object_type": { "enum": ["table", "view", "trigger", "routine", "mysql_event"] },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "owner": { "enum": ["A", "B", "C", "D"] },
        "category": { "enum": ["users", "ai_gateway", "instances", "teams", "skill_hub", "resources", "system_backup"] },
        "data_classification": { "type": ["string", "null"], "enum": ["public", "internal", "confidential", "secret", null] },
        "backup_strategy": { "type": ["string", "null"], "enum": ["mysql_dump", "metadata_only", "exclude", null] },
        "restore_strategy": { "type": ["string", "null"], "enum": ["restore", "normalize", "reference_only", "exclude", null] },
        "excluded_reason": { "type": ["string", "null"], "enum": ["platform_bootstrap", "derived_runtime_state", "external_unmanaged", "unsupported_p0", "sensitive_never_backup", null] },
        "normalizer_id": { "type": ["string", "null"], "maxLength": 255 },
        "verifier_id": { "type": ["string", "null"], "maxLength": 255 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(table|view|trigger|routine|mysql_event):[a-z][a-z0-9_]*$" } },
        "decision_status": { "enum": ["pending_owner_review", "owner_recorded", "frozen"] },
        "required_cross_reviewers": { "type": "array", "uniqueItems": true, "items": { "enum": ["A", "B", "C", "D"] } },
        "approved_cross_reviewers": { "type": "array", "uniqueItems": true, "items": { "enum": ["A", "B", "C", "D"] } },
        "redacted_explanation": { "type": ["string", "null"], "maxLength": 1024 },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration", "repository_create", "repository_alter", "deployment_bootstrap", "exception"],
          "properties": {
            "migration": { "type": "array", "items": { "type": "string" } },
            "repository_create": { "type": "array", "items": { "type": "string" } },
            "repository_alter": { "type": "array", "items": { "type": "string" } },
            "deployment_bootstrap": { "type": "array", "items": { "type": "string" } },
            "exception": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft"
}
