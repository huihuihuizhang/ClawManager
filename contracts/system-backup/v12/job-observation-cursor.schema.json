{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/job-observation-cursor.schema.json",
  "title": "D-owned current Job observation cursor and command slot",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin_installation_id", "target_type", "target_public_id", "attempt_no", "phase", "job_unit_key", "job_uid", "job_generation", "relay_identity_ref", "relay_identity_version", "relay_identity_bound_at", "relay_identity_expires_at", "last_accepted_sequence", "last_accepted_body_sha256", "last_observed_status", "last_observed_at", "progress_sequence", "progress_digest_sha256", "last_business_progress_at", "command_nonce", "command_sha256", "command_job_generation", "command_fencing_token", "command_created_at", "command_read_at", "row_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "system-backup-job-observation.v1" },
    "origin_installation_id": { "type": "string", "pattern": "^installation_[A-Za-z0-9._:-]{1,115}$" },
    "target_type": { "enum": ["backup", "drill", "preflight", "artifact_verify"] },
    "target_public_id": { "type": "string", "pattern": "^(sbk|sdr|spf|sav)_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "attempt_no": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["capture", "secret_capture", "publish", "restore", "normalize", "verify", "preflight"] },
    "job_unit_key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$", "description": "Stable B-reviewed Job-set unit key within one attempt phase." },
    "job_uid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "job_generation": { "type": "integer", "minimum": 1 },
    "relay_identity_ref": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Non-replayable identity reference, never credential material." },
    "relay_identity_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "relay_identity_bound_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "relay_identity_expires_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "last_accepted_sequence": { "type": "integer", "minimum": 0 },
    "last_accepted_body_sha256": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Sha256" }, { "type": "null" }] },
    "last_observed_status": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "B-owned status-relay enum pending; D stores only the bounded code." },
    "last_observed_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "progress_sequence": { "type": "integer", "minimum": 0 },
    "progress_digest_sha256": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Sha256" }, { "type": "null" }] },
    "last_business_progress_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "command_nonce": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "Single-use random command nonce, not a credential or fencing authority by itself." },
    "command_sha256": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Sha256" }, { "type": "null" }] },
    "command_job_generation": { "type": ["integer", "null"], "minimum": 1 },
    "command_fencing_token": { "type": ["integer", "null"], "minimum": 1 },
    "command_created_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "command_read_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "target_type": { "const": "backup" } }, "required": ["target_type"] }, "then": { "properties": { "target_public_id": { "pattern": "^sbk_" }, "phase": { "enum": ["capture", "secret_capture", "publish"] } } } },
    { "if": { "properties": { "target_type": { "const": "drill" } }, "required": ["target_type"] }, "then": { "properties": { "target_public_id": { "pattern": "^sdr_" }, "phase": { "enum": ["restore", "normalize", "verify"] } } } },
    { "if": { "properties": { "target_type": { "const": "preflight" } }, "required": ["target_type"] }, "then": { "properties": { "target_public_id": { "pattern": "^spf_" }, "phase": { "const": "preflight" } } } },
    { "if": { "properties": { "target_type": { "const": "artifact_verify" } }, "required": ["target_type"] }, "then": { "properties": { "target_public_id": { "pattern": "^sav_" }, "phase": { "const": "verify" } } } },
    { "if": { "properties": { "last_accepted_sequence": { "const": 0 } }, "required": ["last_accepted_sequence"] }, "then": { "properties": { "last_accepted_body_sha256": { "type": "null" }, "last_observed_status": { "type": "null" }, "last_observed_at": { "type": "null" } } }, "else": { "properties": { "last_accepted_body_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" }, "last_observed_status": { "type": "string" }, "last_observed_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "progress_sequence": { "const": 0 } }, "required": ["progress_sequence"] }, "then": { "properties": { "progress_digest_sha256": { "type": "null" }, "last_business_progress_at": { "type": "null" } } }, "else": { "properties": { "progress_digest_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" }, "last_business_progress_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "command_nonce": { "type": "null" } }, "required": ["command_nonce"] }, "then": { "properties": { "command_sha256": { "type": "null" }, "command_job_generation": { "type": "null" }, "command_fencing_token": { "type": "null" }, "command_created_at": { "type": "null" }, "command_read_at": { "type": "null" } } }, "else": { "properties": { "phase": { "enum": ["capture", "secret_capture"] }, "command_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" }, "command_job_generation": { "type": "integer", "minimum": 1 }, "command_fencing_token": { "type": "integer", "minimum": 1 }, "command_created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } }
  ],
  "x-cas-invariants": ["Accept a relay message only when installation, task, attempt, phase, Job UID, generation and relay identity all match the row and its unexpired binding.", "First accepted message has sequence 1; the next accepted sequence is previous+1. A repeated sequence is acknowledged only if its body hash equals the stored hash; gaps and changed bodies are rejected in the same transaction.", "Replacing a Job increments generation and resets accepted/progress cursors and command slot in one CAS; the old UID/result is retained in a redacted event, not a second active attempt.", "Only registered monotonic bytes/items/checkpoint/resource lifecycle changes may advance progress_sequence and last_business_progress_at; heartbeat and log lines may advance the message cursor but not business progress.", "Command publish and read bind the current generation and fencing token in the same transaction; a previous generation cannot read or consume the slot."],
  "x-pending-owner-contract": "B-owned status_relay wire envelope, observed status enum, Job-set unit keys and progress field allowlist remain missing; this D ledger does not define or approve them.",
  "x-forbidden-fields": ["credential", "relay_private_key", "raw_result", "manifest", "log_line", "index_payload"]
}
