{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/staging-resource-lifecycle.schema.json",
  "title": "D-owned backup staging resource inventory and lifecycle",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_id", "origin_installation_id", "backup_public_id", "attempt_no", "phase", "phase_uid", "resource_type", "planned_locator", "location_sha256", "owner_marker_hmac", "owner_marker_key_version", "observed_name", "observed_uid", "immutable_version", "candidate_checksum_sha256", "candidate_length_bytes", "lifecycle", "cleanup_result", "last_failure_code", "cleanup_operation_public_id", "ownership_resolution_operation_public_id", "ownership_resolution_evidence_public_id", "claim_owner", "claim_expires_at", "next_reconcile_at", "row_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "system-backup-staging-resource.v1" },
    "public_id": { "type": "string", "pattern": "^sbs_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "origin_installation_id": { "type": "string", "pattern": "^installation_[A-Za-z0-9._:-]{1,115}$" },
    "backup_public_id": { "type": "string", "pattern": "^sbk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "attempt_no": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["capture", "secret_capture", "publish"] },
    "phase_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "resource_type": { "enum": ["pvc", "hostpath", "remote_manifest_candidate"] },
    "planned_locator": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "Redacted, non-credential-bearing planned location; never a presigned URL." },
    "location_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" },
    "owner_marker_hmac": { "$ref": "artifact-common.schema.json#/$defs/Sha256" },
    "owner_marker_key_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "observed_name": { "type": ["string", "null"], "maxLength": 256 },
    "observed_uid": { "type": ["string", "null"], "maxLength": 256 },
    "immutable_version": { "type": ["string", "null"], "maxLength": 256 },
    "candidate_checksum_sha256": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Sha256" }, { "type": "null" }] },
    "candidate_length_bytes": { "type": ["integer", "null"], "minimum": 1, "maximum": 262144 },
    "lifecycle": { "enum": ["creating", "absent", "ready", "sealed", "deleting", "deleted", "delete_failed", "ownership_unknown"] },
    "cleanup_result": { "enum": ["not_started", "running", "succeeded", "failed"] },
    "last_failure_code": { "enum": ["none", "deadline_exceeded", "provider_unavailable", "permission_denied", "identity_mismatch", "checksum_mismatch", "ownership_unknown", "residual_data", "internal"] },
    "cleanup_operation_public_id": { "type": ["string", "null"], "pattern": "^sop_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ownership_resolution_operation_public_id": { "type": ["string", "null"], "pattern": "^sop_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ownership_resolution_evidence_public_id": { "type": ["string", "null"], "pattern": "^sev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "claim_owner": { "type": ["string", "null"], "maxLength": 128 },
    "claim_expires_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "next_reconcile_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "resource_type": { "const": "remote_manifest_candidate" } }, "required": ["resource_type"] }, "then": { "properties": { "phase": { "const": "publish" } } }, "else": { "properties": { "phase": { "enum": ["capture", "secret_capture"] }, "candidate_checksum_sha256": { "type": "null" }, "candidate_length_bytes": { "type": "null" } } } },
    { "if": { "properties": { "lifecycle": { "enum": ["creating", "ready", "sealed"] } }, "required": ["lifecycle"] }, "then": { "properties": { "cleanup_result": { "const": "not_started" }, "last_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "lifecycle": { "const": "deleting" } }, "required": ["lifecycle"] }, "then": { "properties": { "cleanup_result": { "const": "running" }, "last_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "lifecycle": { "enum": ["absent", "deleted"] } }, "required": ["lifecycle"] }, "then": { "properties": { "cleanup_result": { "const": "succeeded" }, "last_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "lifecycle": { "const": "ownership_unknown" } }, "required": ["lifecycle"] }, "then": { "properties": { "cleanup_result": { "const": "failed" }, "last_failure_code": { "const": "ownership_unknown" } } } },
    { "if": { "properties": { "lifecycle": { "const": "delete_failed" } }, "required": ["lifecycle"] }, "then": { "properties": { "cleanup_result": { "const": "failed" }, "last_failure_code": { "not": { "enum": ["none", "ownership_unknown"] } } } } },
    { "if": { "properties": { "candidate_checksum_sha256": { "type": "null" } }, "required": ["candidate_checksum_sha256"] }, "then": { "properties": { "candidate_length_bytes": { "type": "null" } } }, "else": { "properties": { "candidate_length_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 } } } },
    { "if": { "properties": { "resource_type": { "const": "remote_manifest_candidate" }, "lifecycle": { "const": "sealed" } }, "required": ["resource_type", "lifecycle"] }, "then": { "properties": { "immutable_version": { "type": "string", "minLength": 1 }, "candidate_checksum_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" }, "candidate_length_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 } } } },
    { "if": { "properties": { "lifecycle": { "const": "absent" } }, "required": ["lifecycle"] }, "then": { "properties": { "observed_name": { "type": "null" }, "observed_uid": { "type": "null" }, "immutable_version": { "type": "null" } } } },
    { "if": { "properties": { "ownership_resolution_operation_public_id": { "type": "null" } }, "required": ["ownership_resolution_operation_public_id"] }, "then": { "properties": { "ownership_resolution_evidence_public_id": { "type": "null" } } }, "else": { "properties": { "ownership_resolution_evidence_public_id": { "type": "string" } } } },
    { "if": { "properties": { "claim_owner": { "type": "null" } }, "required": ["claim_owner"] }, "then": { "properties": { "claim_expires_at": { "type": "null" } } }, "else": { "properties": { "claim_expires_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } }
  ],
  "x-lifecycle-transitions": {
    "creating": ["absent", "ready", "sealed", "ownership_unknown"],
    "ready": ["sealed", "deleting", "ownership_unknown"],
    "sealed": ["deleting", "ownership_unknown"],
    "deleting": ["deleted", "delete_failed", "ownership_unknown"],
    "delete_failed": ["deleting", "ownership_unknown"],
    "ownership_unknown": ["absent", "ready", "sealed"],
    "absent": [],
    "deleted": []
  },
  "x-ownership-resolution": "Only a succeeded ownership_resolution operation with registered provider evidence may move ownership_unknown to absent, ready or sealed. A remaining resource needs a new cleanup operation before deleting.",
  "x-forbidden-fields": ["credential", "credential_envelope", "presigned_url", "authorization", "plaintext_key"]
}
