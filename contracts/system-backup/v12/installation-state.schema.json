{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/installation-state.schema.json",
  "title": "System backup installation state",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin_installation_id", "active_config_version", "first_enabled_at", "last_effective_enabled", "last_effective_enabled_transition_at", "monitoring_armed", "monitoring_armed_reason", "matrix_key", "matrix_transition_operation_id", "row_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "system-backup-installation-state.v1" },
    "origin_installation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "active_config_version": { "type": "integer", "minimum": 1 },
    "first_enabled_at": { "type": ["string", "null"], "format": "date-time" },
    "last_effective_enabled": { "type": "boolean" },
    "last_effective_enabled_transition_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "monitoring_armed": { "type": "boolean" },
    "monitoring_armed_reason": { "enum": ["none", "deployment_required", "previously_enabled"] },
    "matrix_key": { "enum": ["k8s-cluster", "k3s-cluster", "k8s-single-node", "k3s-single-node"] },
    "matrix_transition_operation_id": { "type": ["string", "null"], "pattern": "^sop_[A-Za-z0-9_-]+$" },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "monitoring_armed": { "const": false } }, "required": ["monitoring_armed"] },
      "then": { "properties": { "monitoring_armed_reason": { "const": "none" }, "first_enabled_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "monitoring_armed": { "const": true } }, "required": ["monitoring_armed"] },
      "then": { "properties": { "monitoring_armed_reason": { "enum": ["deployment_required", "previously_enabled"] } } }
    },
    {
      "if": { "properties": { "monitoring_armed_reason": { "const": "previously_enabled" } }, "required": ["monitoring_armed_reason"] },
      "then": { "properties": { "first_enabled_at": { "type": "string", "format": "date-time" } } }
    }
  ],
  "x-invariants": [
    "There is exactly one row per origin_installation_id.",
    "The controller may set first_enabled_at once by row-version CAS; config PUT and rollback cannot clear, copy or reset it.",
    "effective_enabled is derived only as SYSTEM_BACKUP_ENABLED AND the active config enabled value; neither input is copied into an owner payload.",
    "monitoring_armed is irreversible and equals SYSTEM_BACKUP_REQUIRED OR first_enabled_at IS NOT NULL; deployment_required applies before first enable and previously_enabled applies afterward.",
    "matrix_key is derived from the observed orchestrator and deployment profile; clients cannot supply it.",
    "A matrix change is recorded by a system operation before new work is admitted."
  ]
}
