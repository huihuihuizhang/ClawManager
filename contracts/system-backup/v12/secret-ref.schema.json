{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/secret-ref.schema.json",
  "title": "A-owned typed secret and security reference",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "description": "Closed redacted reference union for KMS keys, secret refs, signing keys and provider credentials. It identifies immutable refs by hash/version only and never carries material, endpoints or provider URLs.",
  "oneOf": [
    {
      "$ref": "#/$defs/ExternalKMSKeyRef"
    },
    {
      "$ref": "#/$defs/ExternalSecretRef"
    },
    {
      "$ref": "#/$defs/KubernetesSecretRef"
    },
    {
      "$ref": "#/$defs/SigningKeyRef"
    },
    {
      "$ref": "#/$defs/ProviderCredentialRef"
    },
    {
      "$ref": "#/$defs/CATrustRef"
    }
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "RefVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:latest|current|default)$)[A-Za-z0-9._:-]+$"
    },
    "Common": {
      "type": "object",
      "required": [
        "ref_kind",
        "purpose",
        "identity_hash",
        "identity_version",
        "provider_identity_hash",
        "scope_hash",
        "description_redacted"
      ],
      "properties": {
        "ref_kind": {
          "$ref": "#/$defs/RefKind"
        },
        "purpose": {
          "$ref": "#/$defs/RefPurpose"
        },
        "identity_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "identity_version": {
          "$ref": "#/$defs/RefVersion"
        },
        "provider_identity_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "scope_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "description_redacted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "RefKind": {
      "type": "string",
      "enum": [
        "external_kms_key",
        "external_secret",
        "kubernetes_secret",
        "signing_key",
        "artifact_credential",
        "catalog_credential",
        "evidence_credential",
        "ca_bundle"
      ]
    },
    "RefPurpose": {
      "type": "string",
      "enum": [
        "data_key_generation",
        "kek_unwrap",
        "secret_bundle_part",
        "capture_certificate",
        "acceptance_record",
        "catalog_record",
        "artifact_write",
        "artifact_read",
        "catalog_append",
        "evidence_read_write",
        "provider_proof_issuer",
        "strong_auth_issuer",
        "strong_auth_nonce_hmac",
        "kek_wrap",
        "artifact_delete",
        "catalog_read",
        "catalog_discovery",
        "evidence_read",
        "evidence_write",
        "evidence_delete",
        "artifact_ca",
        "catalog_ca",
        "evidence_ca"
      ]
    },
    "ExternalKMSKeyRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted",
            "kms_capability"
          ],
          "properties": {
            "ref_kind": {
              "const": "external_kms_key"
            },
            "purpose": {
              "enum": [
                "data_key_generation",
                "kek_unwrap"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kms_capability": {
              "enum": [
                "generate_data_key",
                "unwrap_data_key"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "data_key_generation"
                  }
                }
              },
              "then": {
                "properties": {
                  "kms_capability": {
                    "const": "generate_data_key"
                  }
                }
              },
              "else": {
                "properties": {
                  "kms_capability": {
                    "const": "unwrap_data_key"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "ExternalSecretRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted",
            "read_mode"
          ],
          "properties": {
            "ref_kind": {
              "const": "external_secret"
            },
            "purpose": {
              "enum": [
                "secret_bundle_part",
                "strong_auth_nonce_hmac",
                "kek_wrap",
                "kek_unwrap"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "read_mode": {
              "const": "exact_version_only"
            }
          },
          "x-purpose-policy": "Nonce HMAC is HMAC-SHA256 with an immutable exact-version resource; never latest/default fallback. Secret KEK wrap/unwrap is AES-256-KW and functional-test only. Material is resolved locally by the authorized task identity, never serialized in this ref."
        }
      ]
    },
    "KubernetesSecretRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted",
            "namespace_hash",
            "name_hash",
            "uid_hash",
            "key_name_hash",
            "read_mode"
          ],
          "properties": {
            "ref_kind": {
              "const": "kubernetes_secret"
            },
            "purpose": {
              "enum": [
                "secret_bundle_part",
                "strong_auth_nonce_hmac",
                "kek_wrap",
                "kek_unwrap"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "namespace_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "name_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "uid_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "key_name_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "read_mode": {
              "const": "resource_name_get_only"
            }
          },
          "x-purpose-policy": "Nonce HMAC is HMAC-SHA256 with an immutable exact-version resource; never latest/default fallback. Secret KEK wrap/unwrap is AES-256-KW and functional-test only. Material is resolved locally by the authorized task identity, never serialized in this ref."
        }
      ]
    },
    "SigningKeyRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted",
            "algorithm",
            "domain_separator"
          ],
          "properties": {
            "ref_kind": {
              "const": "signing_key"
            },
            "purpose": {
              "enum": [
                "capture_certificate",
                "acceptance_record",
                "catalog_record",
                "provider_proof_issuer",
                "strong_auth_issuer"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "algorithm": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "domain_separator": {
              "type": "string",
              "pattern": "^clawmanager\\.system-backup\\.[a-z0-9_.-]+\\.v[0-9]+$"
            }
          }
        },
        {
          "if": { "properties": { "purpose": { "enum": ["capture_certificate", "acceptance_record", "catalog_record"] } }, "required": ["purpose"] },
          "then": { "properties": { "algorithm": { "const": "EdDSA" } } }
        }
      ]
    },
    "ProviderCredentialRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted",
            "provider_role",
            "credential_capability"
          ],
          "properties": {
            "ref_kind": {
              "enum": [
                "artifact_credential",
                "catalog_credential",
                "evidence_credential"
              ]
            },
            "purpose": {
              "enum": [
                "artifact_write",
                "artifact_read",
                "artifact_delete",
                "catalog_append",
                "catalog_read",
                "catalog_discovery",
                "evidence_read_write",
                "evidence_read",
                "evidence_write",
                "evidence_delete"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "provider_role": {
              "enum": [
                "artifact",
                "catalog",
                "evidence"
              ]
            },
            "credential_capability": {
              "enum": [
                "exact_write",
                "exact_read",
                "exact_delete",
                "conditional_create",
                "append_record",
                "range_read",
                "snapshot_list",
                "inventory_read"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "ref_kind": {
                    "const": "artifact_credential"
                  }
                },
                "required": [
                  "ref_kind"
                ]
              },
              "then": {
                "properties": {
                  "provider_role": {
                    "const": "artifact"
                  },
                  "purpose": {
                    "enum": [
                      "artifact_write",
                      "artifact_read",
                      "artifact_delete"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "ref_kind": {
                    "const": "catalog_credential"
                  }
                },
                "required": [
                  "ref_kind"
                ]
              },
              "then": {
                "properties": {
                  "provider_role": {
                    "const": "catalog"
                  },
                  "purpose": {
                    "enum": [
                      "catalog_append",
                      "catalog_read",
                      "catalog_discovery"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "ref_kind": {
                    "const": "evidence_credential"
                  }
                },
                "required": [
                  "ref_kind"
                ]
              },
              "then": {
                "properties": {
                  "provider_role": {
                    "const": "evidence"
                  },
                  "purpose": {
                    "enum": [
                      "evidence_read_write",
                      "evidence_read",
                      "evidence_write",
                      "evidence_delete"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "artifact_write"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_write",
                      "conditional_create"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "artifact_read"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_read",
                      "range_read"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "artifact_delete"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_delete"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "catalog_append"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "append_record"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "catalog_read"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_read"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "catalog_discovery"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "snapshot_list",
                      "inventory_read"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "evidence_read_write"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_read",
                      "range_read",
                      "exact_write",
                      "conditional_create"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "evidence_read"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_read",
                      "range_read"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "evidence_write"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_write",
                      "conditional_create"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "const": "evidence_delete"
                  }
                },
                "required": [
                  "purpose"
                ]
              },
              "then": {
                "properties": {
                  "credential_capability": {
                    "enum": [
                      "exact_delete"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "CATrustRef": {
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        },
        {
          "type": "object",
          "required": [
            "ref_kind",
            "purpose",
            "identity_hash",
            "identity_version",
            "provider_identity_hash",
            "scope_hash",
            "description_redacted"
          ],
          "properties": {
            "ref_kind": {
              "const": "ca_bundle"
            },
            "purpose": {
              "enum": [
                "artifact_ca",
                "catalog_ca",
                "evidence_ca"
              ]
            },
            "identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "identity_version": {
              "$ref": "#/$defs/RefVersion"
            },
            "provider_identity_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "scope_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "description_redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "x-redaction-rule": "Only hashes, immutable versions, closed purpose codes and redacted labels may leave the A boundary. Raw key material, clear names, provider locations and credentials are forbidden in manifests, events, audit details, errors and evidence.",
  "x-forbidden-fields": [
    "uri",
    "url",
    "endpoint",
    "credential",
    "credential_bytes",
    "secret_value",
    "token",
    "password",
    "private_key",
    "key_material",
    "raw_response",
    "raw_log"
  ],
  "x-version-and-retention-rules": [
    "identity_version identifies an immutable resource version (Kubernetes resourceVersion together with uid_hash); aliases such as latest/current/default cannot resolve a retained version.",
    "D loads the required nonce-HMAC versions from persisted config history union retained nonce ledger rows, including the active version; A rejects an empty, duplicate, missing or unresolved version set. D locks/rechecks the snapshot and atomically checks all candidates with nonce consumption, audit intent and mutation. Old material remains until the last referring nonce has passed control retention.",
    "Each provider credential ref grants exactly its declared capability. Read/write legacy purposes never grant deletion; deletion uses a separate identity/ref and purpose. CA refs only locate versioned public trust bundles, never private material."
  ]
}
