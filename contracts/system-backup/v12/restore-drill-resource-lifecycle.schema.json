{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/restore-drill-resource-lifecycle.schema.json",
  "title": "D-owned restore drill resource intent and cleanup lifecycle",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_id", "origin_installation_id", "drill_public_id", "resource_type", "planned_name", "observed_name", "observed_uid", "immutable_version", "location_sha256", "owner_token_hmac", "owner_token_key_version", "lifecycle", "cleanup_operation_public_id", "ownership_resolution_operation_public_id", "ownership_resolution_evidence_public_id", "ownership_resolution_evidence_sha256", "last_failure_code", "failure_message", "observed_at", "claim_owner", "claim_expires_at", "next_reconcile_at", "row_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "system-restore-drill-resource.v1" },
    "public_id": { "type": "string", "pattern": "^srr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "origin_installation_id": { "type": "string", "pattern": "^installation_[A-Za-z0-9._:-]{1,115}$" },
    "drill_public_id": { "type": "string", "pattern": "^sdr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "resource_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "B-owned restore_target resource-type enum pending; no D-invented values are frozen." },
    "planned_name": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Server-derived redacted resource name, never a credential-bearing locator." },
    "observed_name": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "observed_uid": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "immutable_version": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "location_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" },
    "owner_token_hmac": { "$ref": "artifact-common.schema.json#/$defs/Sha256" },
    "owner_token_key_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "lifecycle": { "enum": ["creating", "absent", "created", "deleting", "deleted", "delete_failed", "ownership_unknown"] },
    "cleanup_operation_public_id": { "type": ["string", "null"], "pattern": "^sop_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ownership_resolution_operation_public_id": { "type": ["string", "null"], "pattern": "^sop_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ownership_resolution_evidence_public_id": { "type": ["string", "null"], "pattern": "^sev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ownership_resolution_evidence_sha256": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Sha256" }, { "type": "null" }] },
    "last_failure_code": { "enum": ["none", "deadline_exceeded", "provider_unavailable", "permission_denied", "identity_mismatch", "checksum_mismatch", "ownership_unknown", "residual_data", "internal"] },
    "failure_message": { "type": ["string", "null"], "maxLength": 2048, "description": "Bounded redacted diagnostic only." },
    "observed_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "claim_owner": { "type": ["string", "null"], "maxLength": 128 },
    "claim_expires_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "next_reconcile_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "lifecycle": { "enum": ["creating", "absent", "created", "deleting", "deleted"] } }, "required": ["lifecycle"] }, "then": { "properties": { "last_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "lifecycle": { "const": "delete_failed" } }, "required": ["lifecycle"] }, "then": { "properties": { "last_failure_code": { "not": { "enum": ["none", "ownership_unknown"] } } } } },
    { "if": { "properties": { "lifecycle": { "const": "ownership_unknown" } }, "required": ["lifecycle"] }, "then": { "properties": { "last_failure_code": { "const": "ownership_unknown" } } } },
    { "if": { "properties": { "lifecycle": { "const": "absent" } }, "required": ["lifecycle"] }, "then": { "properties": { "observed_name": { "type": "null" }, "observed_uid": { "type": "null" }, "immutable_version": { "type": "null" } } } },
    { "if": { "properties": { "lifecycle": { "enum": ["created", "deleting", "deleted", "delete_failed"] } }, "required": ["lifecycle"] }, "then": { "anyOf": [{ "properties": { "observed_name": { "type": "string" } } }, { "properties": { "observed_uid": { "type": "string" } } }, { "properties": { "immutable_version": { "type": "string" } } }] } },
    { "if": { "properties": { "ownership_resolution_operation_public_id": { "type": "null" } }, "required": ["ownership_resolution_operation_public_id"] }, "then": { "properties": { "ownership_resolution_evidence_public_id": { "type": "null" }, "ownership_resolution_evidence_sha256": { "type": "null" } } }, "else": { "properties": { "ownership_resolution_evidence_public_id": { "type": "string" }, "ownership_resolution_evidence_sha256": { "$ref": "artifact-common.schema.json#/$defs/Sha256" } } } },
    { "if": { "properties": { "claim_owner": { "type": "null" } }, "required": ["claim_owner"] }, "then": { "properties": { "claim_expires_at": { "type": "null" } } }, "else": { "properties": { "claim_expires_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } }
  ],
  "x-lifecycle-transitions": {
    "creating": ["absent", "created", "ownership_unknown"],
    "created": ["deleting", "ownership_unknown"],
    "deleting": ["deleted", "delete_failed", "ownership_unknown"],
    "delete_failed": ["deleting", "ownership_unknown"],
    "ownership_unknown": ["absent", "created"],
    "absent": [],
    "deleted": []
  },
  "x-ownership-resolution": "Only a succeeded ownership-resolution operation with registered provider evidence may move ownership_unknown to absent or created; a remaining resource requires a new cleanup operation before deleting.",
  "x-pending-owner-contract": "B-owned restore_target resource-type enum, planned/observed provider identity rules and actual creation/deletion probes remain missing; this D ledger does not define or approve them.",
  "x-forbidden-fields": ["credential", "credential_envelope", "presigned_url", "raw_owner_token", "plaintext_secret", "created_boolean"]
}
