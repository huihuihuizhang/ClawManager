{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawmanager.dev/contracts/system-backup/v12/maintenance-participant-state.schema.json",
  "title": "D-owned durable quiesce participant state",
  "x-contract-version": "system-backup-plan.v12",
  "x-contract-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin_installation_id", "scope", "participant_id", "gate_generation", "desired_state", "observed_state", "checkpoint_ref", "checkpoint_offset", "last_completed_mutation_id", "heartbeat_at", "pause_requested_at", "pause_ack_at", "resume_requested_at", "resume_ack_at", "resume_result", "participant_failure_code", "failure_at", "row_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "system-maintenance-participant.v1" },
    "origin_installation_id": { "type": "string", "pattern": "^installation_[A-Za-z0-9._:-]{1,115}$" },
    "scope": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "participant_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "gate_generation": { "type": "integer", "minimum": 1 },
    "desired_state": { "enum": ["running", "paused"] },
    "observed_state": { "enum": ["running", "pausing", "paused", "resuming", "error"] },
    "checkpoint_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 256, "description": "Redacted, non-replayable checkpoint identity only." },
    "checkpoint_offset": { "type": ["integer", "null"], "minimum": 0 },
    "last_completed_mutation_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "heartbeat_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "pause_requested_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "pause_ack_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "resume_requested_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "resume_ack_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "resume_result": { "enum": ["none", "succeeded", "forced", "failed"] },
    "participant_failure_code": { "enum": ["none", "heartbeat_lost", "pause_failed", "resume_failed", "forced_resume", "generation_conflict", "deadline_exceeded", "internal"] },
    "failure_at": { "oneOf": [{ "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "observed_state": { "const": "running" } }, "required": ["observed_state"] }, "then": { "properties": { "desired_state": { "const": "running" }, "resume_result": { "enum": ["none", "succeeded", "forced"] } } } },
    { "if": { "properties": { "observed_state": { "enum": ["pausing", "paused"] } }, "required": ["observed_state"] }, "then": { "properties": { "desired_state": { "const": "paused" }, "resume_result": { "const": "none" }, "participant_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "observed_state": { "const": "paused" } }, "required": ["observed_state"] }, "then": { "properties": { "pause_requested_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, "pause_ack_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, "heartbeat_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "observed_state": { "const": "resuming" } }, "required": ["observed_state"] }, "then": { "properties": { "desired_state": { "const": "running" }, "resume_result": { "const": "none" }, "participant_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "observed_state": { "const": "error" } }, "required": ["observed_state"] }, "then": { "properties": { "resume_result": { "enum": ["none", "failed"] }, "participant_failure_code": { "not": { "enum": ["none", "forced_resume"] } } } } },
    { "if": { "properties": { "resume_result": { "const": "none" }, "observed_state": { "const": "running" } }, "required": ["resume_result", "observed_state"] }, "then": { "properties": { "participant_failure_code": { "const": "none" } } } },
    { "if": { "properties": { "resume_result": { "const": "succeeded" } }, "required": ["resume_result"] }, "then": { "properties": { "observed_state": { "const": "running" }, "participant_failure_code": { "const": "none" }, "resume_requested_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, "resume_ack_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "resume_result": { "const": "forced" } }, "required": ["resume_result"] }, "then": { "properties": { "observed_state": { "const": "running" }, "participant_failure_code": { "const": "forced_resume" }, "resume_requested_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" }, "resume_ack_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "resume_result": { "const": "failed" } }, "required": ["resume_result"] }, "then": { "properties": { "desired_state": { "const": "running" }, "observed_state": { "const": "error" }, "resume_requested_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "participant_failure_code": { "const": "none" } }, "required": ["participant_failure_code"] }, "then": { "properties": { "failure_at": { "type": "null" } } }, "else": { "properties": { "failure_at": { "$ref": "artifact-common.schema.json#/$defs/Timestamp" } } } },
    { "if": { "properties": { "pause_ack_at": { "type": "string" } }, "required": ["pause_ack_at"] }, "then": { "anyOf": [{ "properties": { "checkpoint_offset": { "type": "integer" } } }, { "properties": { "last_completed_mutation_id": { "type": "string" } } }] } }
  ],
  "x-state-transitions": {
    "running": ["pausing"],
    "pausing": ["paused", "error"],
    "paused": ["resuming"],
    "resuming": ["running", "error"],
    "error": ["resuming"]
  },
  "x-generation-rule": "A new gate generation may reset resume result and failure only after all prior-generation participants are running with succeeded or forced result; acknowledgement generation must match the gate row under the same CAS.",
  "x-watchdog-rule": "Forced resume is a durable safety fact; an event and audit record preserve history when the row is reused for a later generation.",
  "x-forbidden-fields": ["credential", "raw_checkpoint", "plaintext_secret"]
}
